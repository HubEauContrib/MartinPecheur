# Flutter / Dart — la racine est le projet Flutter.
# `android/`, `ios/` et `windows/` sont VERSIONNÉS : ils se modifient à la main
# et portent la signature de release (ADR-013).
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
*.iml
.idea/
.vs/
windows/flutter/ephemeral/
android/.gradle/
android/local.properties

# Projet jetable des essais de T5 (arbitrage 14) : versionné sans ses caches.
# build/, .dart_tool/ et .flutter-plugins-dependencies sont ignorés plus haut,
# à toute profondeur.
spike/t5_tache_de_fond/windows/flutter/ephemeral/
spike/t5_tache_de_fond/android/.gradle/
spike/t5_tache_de_fond/android/local.properties
spike/t5_tache_de_fond/android/.kotlin/

# Signature de release Android — clé et propriétés jamais versionnées
android/key.properties
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

# Secrets et environnement local
.env*.local
*.pem

# Système et éditeurs
.DS_Store
*.swp

# Claude Code — réglages personnels, propres à la machine
# (.claude/settings.json et .claude/commands/ restent versionnés : config d'équipe)
.claude/settings.local.json

# Consignes et réglages propres à un poste — jamais versionnés
CLAUDE.local.md

# Rendus de référence — les images sont versionnées, les écarts d'une
# exécution ne le sont pas : `flutter test` dépose ici l'image produite,
# l'image de référence et leur différence quand un golden tombe.
test/features/goldens/failures/
