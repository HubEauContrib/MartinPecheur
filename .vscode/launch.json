{
  "version": "0.2.0",
  "configurations": [
    {
      // Débogage des tests unitaires : points d'arrêt dans `domain/`, `data/` et
      // `application/`. Ne demande ni appareil, ni émulateur, ni carte — c'est
      // toute la valeur de garder ces couches indépendantes du framework.
      "name": "Déboguer les tests (tous)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
      "args": ["--runInBand", "--no-coverage"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Déboguer les tests (fichier courant)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
      "args": ["--runInBand", "--no-coverage", "${relativeFile}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
