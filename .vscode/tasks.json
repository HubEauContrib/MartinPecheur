{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "verify — typecheck + lint + test",
      "type": "npm",
      "script": "verify",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc"],
      "detail": "Le critère de fin d'étape du projet. Aucune tâche n'est terminée sans lui."
    },
    {
      "label": "typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "typecheck — en continu",
      "type": "shell",
      "command": "npx tsc --noEmit --watch",
      "isBackground": true,
      "problemMatcher": ["$tsc-watch"]
    },
    {
      "label": "lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "test",
      "type": "npm",
      "script": "test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "test — en continu",
      "type": "shell",
      "command": "npx jest --watch",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
